# Copy to .env and replace every secret before deploying.

POSTGRES_USER=bot
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=management_bot

# Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-me

# Generate with:
# python -c "import base64, secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
ENCRYPTION_KEY=replace-me

ACCESS_TOKEN_EXPIRE_DAYS=7
# Set to true when the site is served over HTTPS.
COOKIE_SECURE=false

# Secret used to open /admin and create accounts. Keep it private.
# Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_SECRET=replace-me

LOG_RETENTION_DAYS=7
CORS_ORIGINS=http://localhost:3000

FRONTEND_PORT=3000
BACKEND_PORT=8000
