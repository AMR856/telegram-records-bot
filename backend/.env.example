# PostgreSQL connection string used by SQLAlchemy (asyncpg driver).
DATABASE_URL=postgresql+asyncpg://bot:bot@localhost:5432/management_bot

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=replace-me

# Generate with:
# python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=replace-me

# Auth / cookies
ACCESS_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=false

# Secret used to open /admin and create accounts. Keep it private.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_SECRET=replace-me

# Log retention in days. Set to 0 to keep logs forever.
LOG_RETENTION_DAYS=7

# Comma separated. Only needed when the frontend calls the API directly.
CORS_ORIGINS=http://localhost:3000

# Telegram long-polling timeout in seconds.
TELEGRAM_POLL_TIMEOUT=30
